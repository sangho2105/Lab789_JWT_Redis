@model List<Lab789SalesWebClient.Models.Product>

@{
    ViewData["Title"] = "Index";
}

<div class="text-center">
    <h1 class="display-4">Product List</h1>
    <p>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="CreateProduct" class="btn btn-primary">Add New Product</a>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("Sales"))
        {
            <a asp-action="CreateOrder" class="btn btn-success">Create Order</a>
            <a asp-action="Orders" class="btn btn-secondary">Order List</a>
        }
    </p>
    <table class="table">
        <tr>
            <th>ID</th>
            <th>Image</th>
            <th>Product Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Quantity</th>
        </tr>
        @foreach(var it in Model)
        {
            <tr>
                <td>@it.Id</td>
                <td>
                    @if(!string.IsNullOrEmpty(it.ImageURL))
                    {
                        var imagePath = it.ImageURL.StartsWith("/") ? it.ImageURL : "/" + it.ImageURL;
                        var fullImageUrl = $"http://localhost:5185{imagePath}";
                        <img src="@fullImageUrl" alt="" width="100" />
                    }
                    else
                    {
                        <span>No Photo</span>
                    }
                </td>
                <td>@it.ProductName</td>
                <td>@it.Category</td>
                <td>@it.Price</td>
                <td>@it.Quantity</td>
            </tr>
        }
    </table>
</div>
