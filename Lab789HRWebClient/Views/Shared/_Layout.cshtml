<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lab789HRWebClient</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Lab789HRWebClient.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand font-weight-bold" asp-area="" asp-controller="Home" asp-action="Index">HR Management</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Employees</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TransferRequests" asp-action="MyRequests">My Transfer Requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TransferRequests" asp-action="Create">Submit Request</a>
                            </li>

                            @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning font-weight-bold" asp-controller="TransferRequests" asp-action="Pending">
                                        ★ Pending Approvals
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center me-3 text-white">
                                <span>Hello, <strong>@User.Identity.Name</strong></span>
                                @if (User.IsInRole("Manager"))
                                {
                                    <span class="badge bg-warning text-dark ms-2">Manager</span>
                                }
                                else if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-danger ms-2">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark ms-2">Employee</span>
                                }
                            </li>
                            <li class="nav-item">
                                <form action="http://localhost:5264/Account/Logout" method="post" class="d-inline">
                                    <input type="hidden" name="returnUrl" value="http://localhost:5133/" />
                                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a href="http://localhost:5264/Account/Login?returnUrl=@Uri.EscapeDataString("http://localhost:5133/")" class="btn btn-primary btn-sm px-3">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container text-center">
            &copy; 2026 - Lab789 HR Management System - Aptech HK3
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
