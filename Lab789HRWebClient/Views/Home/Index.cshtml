@model List<Lab789HRWebClient.Models.Employee>

@{
    ViewData["Title"] = "Employee Directory";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <strong>Notification:</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="text-center my-5 py-5">
        <h1 class="display-4 font-weight-bold">Human Resources (HR) Management System</h1>
        <p class="lead text-muted">Please login to view the employee directory and access system features.</p>
        <div class="mt-4">
            <a href="http://localhost:5264/Account/Login?returnUrl=@Uri.EscapeDataString("http://localhost:5133/")" class="btn btn-primary btn-lg px-4 shadow-sm">
                Sign In Now
            </a>
        </div>
    </div>
}
else
{
    <div class="mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="mb-0">Employee Directory</h2>
                <small class="text-muted">Data cached and served via <strong>Redis Cache</strong></small>
            </div>
            <div class="d-flex gap-2">
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <a asp-action="Create" class="btn btn-primary">
                        + Add Employee
                    </a>
                }
                <a asp-controller="TransferRequests" asp-action="Create" class="btn btn-outline-success">
                    Submit Transfer Request
                </a>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Position</th>
                            <th>Salary ($)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var it in Model)
                            {
                                <tr>
                                    <td><strong>#@it.Id</strong></td>
                                    <td>@it.FullName</td>
                                    <td><code>@it.Email</code></td>
                                    <td>
                                        <span class="badge bg-info text-dark fs-6">@it.Department</span>
                                    </td>
                                    <td>@it.Position</td>
                                    <td><strong>@it.Salary.ToString("N0")</strong></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No employee records found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}