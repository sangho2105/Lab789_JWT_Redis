@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center mt-5">
    <div class="card border-danger shadow-sm d-inline-block p-4" style="max-width: 500px;">
        <h1 class="display-3 text-danger"><i class="bi bi-shield-lock"></i> 403</h1>
        <h3 class="text-danger">Access Denied!</h3>
        <p class="text-muted mt-3">
            Your current account does not have sufficient permissions to access this resource or feature (Requires <strong>Manager</strong> or <strong>Admin</strong> role).
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary mt-2">Back to Home</a>
    </div>
</div>
