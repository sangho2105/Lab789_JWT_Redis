@model List<Lab789HRWebClient.Models.DepartmentTransferRequestViewModel>

@{
    ViewData["Title"] = "My Transfer Requests";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-file-earmark-text"></i> My Transfer Requests</h2>
            <p class="text-muted mb-0">Track the status of department transfer requests submitted by you</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            + Submit New Transfer Request
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.Error
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card text-center p-5 shadow-sm border-0">
            <h5 class="text-muted">You have not submitted any transfer requests yet</h5>
            <p class="text-muted">Click the button above to create and submit a new request for manager review.</p>
            <div class="mt-2">
                <a asp-action="Create" class="btn btn-outline-primary">Submit Request Now</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Request ID</th>
                            <th>Current Department</th>
                            <th>Target Department</th>
                            <th>Reason</th>
                            <th>Submitted At</th>
                            <th>Status</th>
                            <th>Review & Feedback</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>#@item.Id</strong></td>
                                <td>
                                    <span class="badge bg-secondary">@item.FromDepartment</span>
                                    @if (!string.IsNullOrEmpty(item.FromPosition))
                                    {
                                        <div><small class="text-muted">@item.FromPosition</small></div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary">@item.ToDepartment</span>
                                    @if (!string.IsNullOrEmpty(item.ToPosition))
                                    {
                                        <div><small class="fw-bold text-primary">@item.ToPosition</small></div>
                                    }
                                </td>
                                <td>@item.Reason</td>
                                <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.Status == "PENDING")
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">PENDING</span>
                                    }
                                    else if (item.Status == "APPROVED")
                                    {
                                        <span class="badge bg-success px-2 py-1">APPROVED</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-2 py-1">REJECTED</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "PENDING")
                                    {
                                        <span class="text-muted italic">Pending manager review...</span>
                                    }
                                    else
                                    {
                                        <div>
                                            <small class="text-muted">Reviewed by: @item.ReviewerEmail</small><br />
                                            @if (!string.IsNullOrEmpty(item.ReviewNote))
                                            {
                                                <small><strong>Note:</strong> @item.ReviewNote</small><br />
                                            }
                                            <small class="text-muted">At: @item.ReviewedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
